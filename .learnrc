# learn-c repo config — sourced by ~/Code/learn-repo/bin/* scripts.
# Shell syntax: KEY="value".

LANG="c"

# Filename shape (the citation lives in each unit's `Source:` header, not the name):
#   src/deitel/ch07_04_pointers_operators.c  +  /* Source: deitel:ch07_04 */
TAG_MODE="filename"

SRC_DIR="src"

# Unit file extension(s). Only .c units carry tags; the shared kr_util.h header
# is library glue, not a tagged learning unit.
UNIT_EXT="c"

# Native build verbs (run inside the Linux/glibc Docker container; see README).
BUILD_CMD="make all"
TEST_CMD="make test"
